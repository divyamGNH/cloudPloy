# These vars are genearlly passed by the api-server when it run the container on the ECS but fill these in if running the code locally on its own

# These are generated by the server
PROJECT_ID=
DEPLOYMENT_ID=

# These are taken as inputs from the users
RUNTIME=
BUILD_COMMAND=
START_COMMAND=
PROJECT_ROOT=
GITHUB_REPOSITORY_URL=

# These need to be given to the sever also in env
BUILDKIT_HOST=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=